# SPA fallback pour LiteSpeed/Apache
RewriteEngine On
RewriteBase /

# 1) Servir les fichiers/dossiers existants (ex.: .js, .css, .json, .csv, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule . - [L]

# 2) Réécrire les URLs SANS extension vers index.html (ex.: /a-propos, /opportunite)
RewriteCond %{REQUEST_URI} !\.[^./]+$ [NC]
RewriteRule . /index.html [L]
